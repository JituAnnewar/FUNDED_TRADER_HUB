# Copy this file to `.env.local` and fill in the values.
# Never commit `.env.local`. On Vercel, add the same keys under
# Project → Settings → Environment Variables.

# ── Site ────────────────────────────────────────────────────────────
# Public URL of the site, without a trailing slash. Used for canonical
# URLs, sitemap and social share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (required from Phase 2) ───────────────────────────────
# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" / "publishable" key. Safe in the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. SERVER ONLY. Used by the seed script and
# the ingest endpoint. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Contact form ───────────────────────────────────────────────────
# Address that receives contact-form notifications.
CONTACT_EMAIL=
# Optional. Without it, messages are still saved and shown in /admin/messages.
RESEND_API_KEY=
# Optional. "From" address for notification emails (must be a verified Resend domain).
# Defaults to Resend's onboarding sender if blank.
RESEND_FROM_EMAIL=
# Secret used to hash visitor IPs for rate limiting. Any long random string.
IP_HASH_SALT=

# ── Spam protection (optional) ─────────────────────────────────────
# Cloudflare Turnstile. If both are blank, honeypot + rate limiting are used.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Trade ingest endpoint (optional) ───────────────────────────────
# Shared secret for POST /api/ingest/trade (HMAC-SHA256 signature header).
# Any long random string. Leave blank to disable the endpoint.
INGEST_SECRET=

# ── Admin ──────────────────────────────────────────────────────────
# Minutes of inactivity before the admin is signed out. Default 30.
ADMIN_IDLE_TIMEOUT_MINUTES=30
